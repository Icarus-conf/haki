# Copy to .env and fill in. .env is never committed.
# Generate secrets with: openssl rand -hex 32

POSTGRES_USER=haki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=haki_db

# Signs login tokens. Changing it signs everyone out.
JWT_SECRET=change-me

# TURN relay for calls (the app's WebRTC config must use the same pair)
TURN_USER=haki
TURN_PASSWORD=change-me

# Timezone for the database and API (they must match)
TZ=UTC
